# =========================
# DASH WEB
# =========================
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
PORT=10000
DASH_DEBUG=false
SESSION_COOKIE_SECURE=false
DASH_AUTH_STRICT=false
DASH_AUTH_ALLOW_PLAINTEXT=false
DASH_USERS_FILE=users.secure.json
# Trên Vercel, ưu tiên DASH_USERS_JSON thay cho file tài khoản.
# DASH_USERS_JSON={"admin":{"password_hash":"scrypt:...","role":"admin","regions":["*"]}}
DASH_WARM_REQUIRE_TOKEN=false
DASH_WARM_TOKEN=replace-with-another-random-secret
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# =========================
# SQL SERVER
# =========================
SQL_SERVER=YOUR_SQL_SERVER
SQL_DATABASE=YOUR_DATABASE
SQL_USERNAME=YOUR_USERNAME
SQL_PASSWORD=YOUR_PASSWORD
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes

# =========================
# DATA RANGE
# =========================
# Có thể bỏ trống, script sẽ tự lấy mặc định 12 tháng gần nhất
START_DATE=2025-01-01
END_DATE=2026-12-31

# =========================
# OUTPUT
# =========================
OUTPUT_DIR=output
OUTPUT_EXCEL_NAME=bao_cao_doanh_thu_tong_hop.xlsx
DASH_CACHE_FORMATS=pkl.gz
